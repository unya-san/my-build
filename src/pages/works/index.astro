---
import BaseLayout from "../../layout/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getCollection } from "astro:content";
import { undefined } from "astro:schema";

const works = await getCollection("works");
// const work = works[0]
---

<BaseLayout   
  title="works"
  description="Works and Projects">

  <h1>Works</h1>
  <p>作品紹介</p>

  <section>
    <p>作品数：{works.length}</p>
    {works.map((work)=>{
      return(
      //   <div>
      //     <p>作品ID:{work.id}</p>
      //     <p>Title:{work.data.title}</p>
      //     <p>説明:{work.data.description}</p>
      //     <p>カテゴリ:{work.data.category}</p>
      //     <p>技術:{work.data.technology}</p>
      // </div>
      // )
      <WorkCard
      title={work.data.title}
      description={work.data.description}
      category={work.data.category}
      thechnology={work.data.technology}
      href={`${import.meta.env.BASE_URL}works/${work.id}/`}
      thumbnail={
        work.data.thumbnail
          ? `${import.meta.env.BASE_URL}${work.data.thumbnail}`
          : ""
      }
      />
    )
    })}
  </section>
</BaseLayout> 
