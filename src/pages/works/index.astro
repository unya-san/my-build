---
import BaseLayout from "../../layout/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getCollection } from "astro:content";
import { undefined } from "astro:schema";

const works = await getCollection("works");
---

<BaseLayout   
  title="works"
  description="Works and Projects">

  <h1>Works</h1>
  <p>作品紹介</p>

  <section class="works-list">
    <p>作品数：{works.length}</p>
    {works.map((work)=>{
      <div>
        <h2>{work.data.title}</h2>
        <p>{work.data.description}</p>
        <p>{work.data.category}</p>
        <p>{work.data.technology}</p>
      </div>
      // <WorkCard
      // title={work.data.title}
      // description={work.data.description}
      // category={work.data.category}
      // thechnology={work.data.technology}
      // href={`${import.meta.env.BASE_URL}works/${work.id}/`}
      // thumbnail={
      //   work.data.thumbnail
      //     ? `${import.meta.env.BASE_URL}${work.data.thumbnail}`
      //     : ""
      // }
      // />
    })}
  </section>

</BaseLayout> 
