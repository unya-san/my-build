---
import "../styles/WorkCard.css";

interface Props {
  title?: string;
  description?: string;
  category?: string;
  thechnology: string;
  href?: string;
  thumbnail?: string;
}

const {
  title,
  description,
  category,
  thechnology,
  href,
  thumbnail,
} = Astro.props;

---

<article class="work-card">
  <a href={href} class="work-card-link">
    <div class="work-card-thumbnail">
      {thumbnail ? (
        <img src={thumbnail} alt={title}/>
      ) : (
        <div class="work-card-no-image">
          NO Image
        </div>
      )}
    </div>

    <div class="work-card-content">
      <p class="work-card-category">{category}</p>
      <h2>{title}</h2>
      <p>{description}</p>
      <p class="work-card-thechnology">
        {thechnology}
      </p>
      </div>
  </a>
</article>
