---
interface Props {
  title?: string;
  category?: string;
  url?: string;
}

const {
  title = "My Build",
  category = "JS/HTML",
  url = `${import.meta.env.BASE_URL}/works/`
} = Astro.props;

---
<body>
  <title>{title}</title>
  <meta name="category" content={category}/>
  <meta name="url" content={url}/>
</body>
