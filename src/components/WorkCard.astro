---
interface Props {
  title?: string;
  description?: string;
  category?: string;
  thechnology: string;
  href?: string;
  thumbnail?: string;
}

const {
  title,
  description,
  category,
  thechnology,
  href,
  thumbnail,
} = Astro.props;

---

<article class="work-card">
  <a href={href}>
    {thumbnail && (
      <img src={thumbnail} alt={title}/>
    )}

    <div class="work-card-content">
      <p class="work-card-category">{category}</p>
      <h2>{title}</h2>
      <p>{description}</p>
      <p class="work-card-thechnology">
        {thechnology}
      </p>
      </div>
  </a>
  <!-- <h2>{title}</h2>
  <p>{description}</p>
  <p>{thechnology}</p>
  <a href={href}>詳細</a> -->
</article>
